{
  "display_information": {
    "name": "refund-gate",
    "description": "Every refund request lands in one channel, and every decision leaves a receipt.",
    "background_color": "#5b46e8"
  },
  "features": {
    "bot_user": {
      "display_name": "refund-gate",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "files:read",
        "files:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
